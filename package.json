{
  "name": "@xingwangzhe/cjk-font-split-native",
  "version": "0.4.12",
  "description": "Native Rust CJK font subsetting and persistent Vite caching. Installs only the native binary for your platform.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "license": "MIT",
  "author": "xingwangzhe <xingwangzhe@outlook.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/xingwangzhe/cjk-font-split-native.git"
  },
  "keywords": [
    "font-subset",
    "cjk",
    "woff2",
    "vite",
    "vite-plugin",
    "napi-rs",
    "rust",
    "font-split"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "dist",
    "README.md",
    "README.en.md",
    "README.ja.md",
    "README.ko.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.txt",
    "LICENSES"
  ],
  "napi": {
    "binaryName": "cjk-font-split-native",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "napi build --platform --release --esm --js index.js --dts index.d.ts",
    "build:ts": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "build:debug": "napi build --platform --esm --js index.js --dts index.d.ts",
    "format": "oxfmt --write README*.md benchmark scripts src test package.json tsconfig*.json .github/workflows/ci.yml && cargo fmt",
    "format:check": "oxfmt --check README*.md benchmark scripts src test package.json tsconfig*.json .github/workflows/ci.yml && cargo fmt -- --check",
    "lint": "oxlint .",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "benchmark": "bun run benchmark/run.ts",
    "ci": "bun run format:check && bun run lint && cargo fmt -- --check && bun run build:ts && bun run typecheck && cargo test --locked && cargo clippy --locked -- -D warnings && bun run build && bun run test && bun run benchmark",
    "build:pgo": "bun run scripts/build-pgo.ts",
    "benchmark:pgo": "bun run scripts/build-pgo.ts --compare",
    "prepublishOnly": "napi pre-publish --npm-dir npm --tag-style npm --no-gh-release"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12",
    "@oxc-node/core": "^0.1.7",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "parse5": "^8.1.1"
  },
  "workspaces": [
    "npm/*"
  ],
  "optionalDependencies": {
    "@xingwangzhe/cjk-font-split-native-linux-x64-gnu": "workspace:*",
    "@xingwangzhe/cjk-font-split-native-win32-x64-msvc": "workspace:*",
    "@xingwangzhe/cjk-font-split-native-linux-x64-musl": "workspace:*",
    "@xingwangzhe/cjk-font-split-native-linux-arm64-gnu": "workspace:*",
    "@xingwangzhe/cjk-font-split-native-darwin-arm64": "workspace:*",
    "@xingwangzhe/cjk-font-split-native-darwin-x64": "workspace:*"
  }
}
