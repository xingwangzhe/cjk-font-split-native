{
  "name": "@xingwangzhe/cjk-font-split-native",
  "version": "0.2.0",
  "description": "Native Rust multilingual font subsetting and persistent cache for Vite builds",
  "type": "module",
  "main": "index.mjs",
  "types": "index.d.mts",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    }
  },
  "license": "MIT",
  "author": "xingwangzhe <xingwangzhe@outlook.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/xingwangzhe/cjk-font-split-native.git"
  },
  "keywords": [
    "font-subset",
    "cjk",
    "woff2",
    "vite",
    "vite-plugin",
    "napi-rs",
    "rust",
    "font-split"
  ],
  "files": [
    "index.mjs",
    "index.d.mts",
    "dist",
    "cjk-font-split-native.*.node",
    "README.md",
    "README.en.md",
    "README.ja.md",
    "README.ko.md",
    "LICENSE"
  ],
  "napi": {
    "binaryName": "cjk-font-split-native",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "napi build --platform --release --esm --js index.mjs --dts index.d.mts",
    "build:ts": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "build:debug": "napi build --platform --esm --js index.mjs --dts index.d.mts",
    "artifacts:assemble": "node scripts/assemble-artifacts.mts",
    "format": "oxfmt --write README*.md benchmark scripts src test package.json tsconfig*.json .github/workflows/ci.yml && cargo fmt",
    "format:check": "oxfmt --check README*.md benchmark scripts src test package.json tsconfig*.json .github/workflows/ci.yml && cargo fmt -- --check",
    "lint": "oxlint .",
    "test": "node --experimental-strip-types --test test/*.test.mts",
    "benchmark": "node benchmark/run.mts",
    "ci": "bun run format:check && bun run lint && cargo fmt -- --check && bun run build:ts && bun run typecheck && cargo test --locked && cargo clippy --locked -- -D warnings && bun run build && bun run test && bun run benchmark",
    "release:local": "node scripts/publish-local.mts"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.5",
    "@oxc-node/core": "^0.1.3",
    "@types/node": "^26.6.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "parse5": "8.0.1"
  }
}
